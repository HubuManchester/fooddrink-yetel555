<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Fooddrink.Pages.CameraPage"
             Title="Camera">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="12">

        <!-- Header -->
        <Label Grid.Row="0" Text="Food Photography"
               FontSize="22" FontAttributes="Bold" HorizontalOptions="Center"
               TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />

        <!-- Photo Preview Area -->
        <Frame Grid.Row="1" CornerRadius="12" Padding="0" IsClippedToBounds="True"
               BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark=#1a1a1a}">
            <Image x:Name="PhotoPreview" Aspect="AspectFit"
                   SemanticProperties.Description="Preview of the captured food photo." />
        </Frame>

        <!-- Controls -->
        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label x:Name="FlashStatus" FontSize="13" VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                <Button Grid.Column="1" x:Name="BtnFlash" Text="Flash Info"
                        Clicked="OnFlashStatus" WidthRequest="110"
                        SemanticProperties.Hint="Check camera flash status" />
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="Take Photo" Clicked="OnTakePhoto"
                        SemanticProperties.Hint="Capture a new food photo using the camera"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                <Button Grid.Column="1" Text="Pick from Gallery"
                        Clicked="OnPickPhoto"
                        SemanticProperties.Hint="Choose a food photo from your gallery" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
